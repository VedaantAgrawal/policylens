{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "policylens",
  "compatibility_date": "2026-08-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dashboard/dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "policylens.vedaantagrawal.com", "custom_domain": true }
  ]
}
